<UserControl x:Class="PDFQFZ.WPF.Controls.NumericSliderRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <!-- 拖动条规范（V141）：标题(上) + 功能说明(中，小灰字，可空自动隐藏) + 滑块行(下)；
         样式：白底 + 蓝边（Color.Primary，与按钮边框一致），圆角 6；阴影未启用（暂无先例，待评估） -->
    <Border BorderBrush="{StaticResource Color.Primary}" BorderThickness="1" CornerRadius="6"
            Background="{StaticResource Color.CardBg}" Padding="8,6">
        <StackPanel>
            <!-- 第一行：标题（§0.7 初始化规范：XAML 绑定显示，不依赖代码赋值） -->
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
            <!-- 说明行：功能一句话描述（SectionHint 小灰字 12.5px），为空自动隐藏 -->
            <TextBlock Text="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       TextWrapping="Wrap" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionHint}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- 第二行：滑块 + 数值框 + 上下箭头；行高统一 28，全部垂直居中，保证水平中线对齐 -->
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="sld" Grid.Column="0" Height="24" VerticalAlignment="Center" Margin="0,0,6,0"
                        IsMoveToPointEnabled="True"
                        ValueChanged="Slider_ValueChanged"
                        PreviewMouseLeftButtonDown="Slider_TrackJump" />
                <!-- MinHeight=0：显式覆盖全局 TextBox 样式 MinHeight=30，避免高度超出行被裁剪 -->
                <TextBox x:Name="txtValue" Grid.Column="1" Width="58" Height="24" MinHeight="0" VerticalAlignment="Center"
                         TextAlignment="Center" VerticalContentAlignment="Center" Padding="0"
                         PreviewTextInput="OnValueBoxPreviewTextInput"
                         DataObject.Pasting="OnValueBoxPaste"
                         KeyDown="OnValueBoxKeyDown" LostFocus="OnValueBoxLostFocus" />
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <RepeatButton x:Name="btnUp" Tag="up" Click="OnSpinClick"
                                  Style="{StaticResource SpinButton}" Width="18" Height="13">
                        <Path Data="{StaticResource Icon.ArrowUp}" Fill="#646A73" Stretch="Uniform" Width="10" Height="6" />
                    </RepeatButton>
                    <RepeatButton x:Name="btnDown" Tag="down" Click="OnSpinClick"
                                  Style="{StaticResource SpinButton}" Width="18" Height="13" Margin="0,2,0,0">
                        <Path Data="{StaticResource Icon.FoldArrow}" Fill="#646A73" Stretch="Uniform" Width="10" Height="6" />
                    </RepeatButton>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
