<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== 颜色令牌 ===================== -->
    <SolidColorBrush x:Key="Color.Primary" Color="#1677FF" />
    <SolidColorBrush x:Key="Color.PrimaryHover" Color="#4096FF" />
    <SolidColorBrush x:Key="Color.PrimaryActive" Color="#0958D9" />
    <SolidColorBrush x:Key="Color.PrimarySoft" Color="#E6F0FF" />
    <SolidColorBrush x:Key="Color.Danger" Color="#E5484D" />
    <SolidColorBrush x:Key="Color.DangerHover" Color="#F06A6E" />
    <SolidColorBrush x:Key="Color.WindowBg" Color="#F5F6FA" />
    <SolidColorBrush x:Key="Color.CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Color.Border" Color="#E5E6EB" />
    <SolidColorBrush x:Key="Color.BorderStrong" Color="#DCDFE6" />
    <SolidColorBrush x:Key="Color.Text" Color="#1F2329" />
    <SolidColorBrush x:Key="Color.TextSecondary" Color="#646A73" />
    <SolidColorBrush x:Key="Color.TextHint" Color="#8A8F99" />
    <SolidColorBrush x:Key="Color.InfoBg" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Color.InfoBorder" Color="#E5E6EB" />

    <!-- ===================== 基础字体 ===================== -->
    <FontFamily x:Key="Font.App">Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>

    <!-- ===================== 文本默认 ===================== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- 从属功能标题：所在功能块未启用（代码置 IsEnabled=False）时文字自动置灰 -->
    <Style x:Key="TextBlock.AutoContextLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Color.TextHint}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== 输入框 ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{StaticResource Color.CardBg}"
                            BorderBrush="{StaticResource Color.BorderStrong}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" MinHeight="{TemplateBinding MinHeight}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Color.Primary}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#E8E8E8" />
                            <Setter Property="Foreground" Value="#999999" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 密码框 ===================== -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" Background="{StaticResource Color.CardBg}"
                            BorderBrush="{StaticResource Color.BorderStrong}"
                            BorderThickness="1" CornerRadius="6"
                            MinHeight="{TemplateBinding MinHeight}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Color.Primary}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="#E8E8E8" />
                            <Setter Property="Foreground" Value="#999999" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 下拉框（完全自定义，含 hover/选中态） ===================== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="8,5">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Color.PrimarySoft}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Color.PrimarySoft}" />
                            <Setter Property="Foreground" Value="{StaticResource Color.Primary}" />
                            <Setter Property="FontWeight" Value="600" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单（方案按钮等弹出的右键/下拉菜单）：与 ComboBoxItem 下拉规范一致——白底、圆角、hover 浅蓝高亮；禁用项文字灰色 -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Color.CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="4" SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="8,5">
                        <!-- 不加 Foreground 本地值/绑定：正常态文字继承 MenuItem.Foreground（黑）；
                             禁用态由模板触发器直接置灰——本地值优先级高于模板触发器，写绑定会导致置灰失效 -->
                        <ContentPresenter x:Name="content" ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="content" Property="TextElement.Foreground" Value="{StaticResource Color.TextHint}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Color.PrimarySoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Color.TextHint}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="root">
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      Background="{StaticResource Color.CardBg}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{StaticResource Color.BorderStrong}" BorderThickness="1"
                                            CornerRadius="6">
                                        <Path x:Name="arrow" Data="{StaticResource Icon.FoldArrow}" Fill="{StaticResource Color.TextSecondary}"
                                              Stretch="Uniform" Width="10" Height="6"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Color.PrimaryHover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Color.Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- 不可编辑模式：显示选中项 -->
                        <ContentPresenter x:Name="contentSite" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          VerticalAlignment="Center" Margin="8,0,28,0" IsHitTestVisible="False" />
                        <!-- 可编辑模式：输入框（默认隐藏，IsEditable=True 时显示） -->
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                 Margin="8,0,28,0" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 Style="{x:Null}" Foreground="{TemplateBinding Foreground}"
                                 FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                 VerticalContentAlignment="Center" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade" StaysOpen="False" VerticalOffset="2">
                            <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{StaticResource Color.CardBg}" BorderBrush="{StaticResource Color.Border}"
                                    BorderThickness="1" CornerRadius="6" Padding="2"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- 禁用=整体淡化（底色+选中项文字一起 Opacity 0.45）。
                                 不要对 Foreground/TextElement.Foreground 设值：选中项文字由
                                 ContentPresenter 内部 TextBlock 呈现，命中隐式 TextBlock 样式
                                 （Style setter 优先级高于属性继承），设置无效（V81 教训，同 §4.5）。 -->
                            <Setter TargetName="root" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="contentSite" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 按钮 ===================== -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="Background" Value="{StaticResource Color.CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬浮：浅蓝底 + 亮蓝边框（明显可感知） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Color.PrimaryHover}" />
                            <Setter TargetName="bd" Property="Background" Value="#F0F7FF" />
                        </Trigger>
                        <!-- 按下：内容随内边距下移 1px 产生按压感 + 整体略变深 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Padding" Value="0,1,0,0" />
                            <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按钮：白底蓝字 -->
    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Color.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.Primary}" />
        <Setter Property="Background" Value="{StaticResource Color.CardBg}" />
    </Style>

    <!-- 方案按钮选中态：浅蓝底 + 蓝边框加粗 + 深蓝加粗字（与视图切换选中态视觉一致，规范 §4.9，加载方案时由代码切换到此样式） -->
    <Style x:Key="Button.PresetSelected" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Color.PrimaryActive}" />
        <Setter Property="Background" Value="{StaticResource Color.PrimarySoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.Primary}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>


    <!-- 方形入口按钮：不带圆角，与圆角操作按钮区分；
         用于"勾选框 + 打开设置弹窗"的组合入口（如盖章渲染）：未勾选时整体置灰不可点，勾选后变亮可点 -->
    <Style x:Key="Button.SecondarySquare" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Color.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.Primary}" />
        <Setter Property="Background" Value="{StaticResource Color.CardBg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Color.PrimaryHover}" />
                            <Setter TargetName="bd" Property="Background" Value="#F0F7FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Padding" Value="0,1,0,0" />
                            <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 视图切换开关：未选中与 Button.Secondary 同风格；选中时蓝边框加粗+浅蓝底+深蓝加粗文字（对齐原版 SetToolbarButtonSelected） -->
    <Style x:Key="Toggle.ViewMode" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Primary}" />
        <Setter Property="Background" Value="{StaticResource Color.CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 选中：浅蓝底 + 蓝边框加粗 + 深蓝加粗字 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Color.PrimarySoft}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Color.Primary}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            <Setter Property="Foreground" Value="{StaticResource Color.PrimaryActive}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <!-- 未选中悬停：边框变亮、背景泛蓝 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Color.PrimaryHover}" />
                            <Setter TargetName="bd" Property="Background" Value="#F5F9FF" />
                        </MultiTrigger>
                        <!-- 选中悬停：浅蓝底略加深 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="#D6E8FF" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主要按钮：蓝底白字 -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource Color.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.Primary}" />
        <Setter Property="FontWeight" Value="600" />
    </Style>

    <!-- 危险主按钮：红底白字；悬停时背景变浅红、边框变浅红（与次要按钮同机制的悬停反馈，白字始终清晰） -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource Color.Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.Danger}" />
        <Setter Property="FontWeight" Value="600" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Color.DangerHover}" />
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Color.DangerHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Padding" Value="0,1,0,0" />
                            <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 勾选 ===================== -->
    <!-- 方形勾选框规范：圆角方框（CornerRadius=3，编号 check-square 4 号风格，非直角非圆形）；
         未选中灰边白底、选中蓝底白勾、hover 亮蓝、禁用变淡。勾形用 Icon.Check（共享图标库 check-square）。 -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel x:Name="root" Orientation="Horizontal">
                        <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                Background="{StaticResource Color.CardBg}"
                                BorderBrush="#C6CAD2" BorderThickness="1"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="tick" Data="{StaticResource Icon.Check}"
                                  Fill="White" Width="9" Height="7"
                                  Stretch="Uniform" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Color.Primary}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Color.Primary}" />
                            <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Color.PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- 禁用=整体淡化（方框+文字一起 Opacity 0.45）。
                                 不要对 content 设 Foreground/TextElement.Foreground：
                                 文字由 TextBlock 隐式样式（Style setter）呈现，优先级高于属性继承，
                                 模板内任何 Foreground 继承/附加值都压不过它（V78~V79 教训）。 -->
                            <Setter TargetName="root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ===================== 卡片 ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.CardBg}" />
        <!-- 分区圆角矩形边框：比全局 Color.Border 更深，保证 1~5 分区边界清晰可见 -->
        <Setter Property="BorderBrush" Value="#C6CAD2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- 区块标题行：编号方块 + 标题 + 右侧 hint -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Color.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.TextHint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 折叠箭头 -->
    <Style x:Key="FoldTip" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.TextHint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- 折叠按钮：轻按钮样式（浅色背景+圆角，hover背景变深） -->
    <!-- 折叠按钮（展开设置/收起设置）：与标准按钮一致（白底蓝边蓝字），
         收起态=蓝字蓝箭头蓝边框；展开态=红字红箭头红边框（颜色由代码按状态切换） -->
    <Style x:Key="FoldButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Color.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color.Primary}" />
        <Setter Property="Background" Value="{StaticResource Color.CardBg}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- 操作提示区文字 -->
    <Style x:Key="LogText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Color.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <!-- ===================== 历史下拉：删除叉（Chrome 搜索历史样式，V116 起用图标 Icon.Close） ===================== -->
    <Style x:Key="HistoryDeleteButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="#B0B3B8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                        <Path Data="{StaticResource Icon.Close}"
                              Fill="{TemplateBinding Foreground}" Stretch="Uniform"
                              Width="9" Height="9"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FFF1F0" />
                            <Setter Property="Foreground" Value="#E5484D" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 按文字历史下拉项：文字 + 右侧删除叉（模板在 MainWindow.Resources，事件绑定到 MainWindow） -->

    <!-- ===================== 使用说明窗口 ===================== -->
    <Style x:Key="HelpSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#1A1A1A" />
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <Style x:Key="HelpBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>


    <!-- ===================== 滚动条（全局统一：细条圆角滑块，悬停加深；点击轨道直接定位由各窗口事件处理） ===================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                              IsHitTestVisible="False" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumbBd" Background="#B8BEC9" CornerRadius="5" Margin="1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumbBd" Property="Background" Value="#9AA1AD" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                              IsHitTestVisible="False" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- 拖动条上下箭头（NumericSliderRow 用）：无边框轻按钮，悬浮浅蓝底，按住连续步进 -->
    <!-- 拖动条上下箭头按钮组：标准 NumericUpDown 样式——浅灰底小按钮、全边框、蓝色箭头、悬浮/按下反馈 -->
    <!-- 拖动条上下箭头按钮：GGStampWatermark 规范——灰箭头 + 白底(#FBFBFC) + 细边框(#DCDFE6)，18×13，上下间距 2 -->
    <Style x:Key="SpinButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="#FBFBFC" />
        <Setter Property="BorderBrush" Value="#DCDFE6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬浮反馈与按钮悬浮态一致：浅蓝底 #F0F7FF + 亮蓝边 Color.PrimaryHover；厚度保持 1 防内容跳动 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Color.PrimaryHover}" />
                            <Setter TargetName="bd" Property="Background" Value="#F0F7FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E8E9EB" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
    </Style>

</ResourceDictionary>