<Window x:Class="PDFQFZ.WPF.PageRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="指定范围页盖章"
        Width="320" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F0F0F0" FontFamily="Microsoft YaHei UI" FontSize="12">
    <StackPanel Margin="20">
        <!-- 起始页：标签 + TextBox + − + +（自然紧凑排列） -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="起始页" Width="56" VerticalAlignment="Center" />
            <TextBox x:Name="txtStart" Width="110" Padding="6,3" Margin="0,0,10,0"
                     TextAlignment="Center" VerticalContentAlignment="Center" />
            <Button x:Name="btnStartDown" Content="−" Width="36" Height="28"
                    VerticalAlignment="Center" Click="OnStartDown" />
            <Button x:Name="btnStartUp" Content="+" Width="36" Height="28"
                    VerticalAlignment="Center" Margin="8,0,0,0" Click="OnStartUp" />
        </StackPanel>

        <!-- 结尾页：标签 + TextBox + − + + -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="结尾页" Width="56" VerticalAlignment="Center" />
            <TextBox x:Name="txtEnd" Width="110" Padding="6,3" Margin="0,0,10,0"
                     TextAlignment="Center" VerticalContentAlignment="Center" />
            <Button x:Name="btnEndDown" Content="−" Width="36" Height="28"
                    VerticalAlignment="Center" Click="OnEndDown" />
            <Button x:Name="btnEndUp" Content="+" Width="36" Height="28"
                    VerticalAlignment="Center" Margin="8,0,0,0" Click="OnEndUp" />
        </StackPanel>

        <!-- 页码范围提示 -->
        <TextBlock x:Name="txtPageCount" Foreground="#888888" FontSize="11" Margin="0,0,0,0" />

        <!-- 确定/取消按钮：右下角 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="btnOk" Content="确定" Width="72" Height="30" Margin="0,0,8,0" Click="OnOkClick" IsDefault="True" />
            <Button x:Name="btnCancel" Content="取消" Width="72" Height="30" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
