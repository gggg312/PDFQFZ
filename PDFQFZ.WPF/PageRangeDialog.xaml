<Window x:Class="PDFQFZ.WPF.PageRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="指定范围页盖章"
        Width="300" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Color.WindowBg}" FontFamily="{StaticResource Font.App}" FontSize="12.5">
    <StackPanel Margin="16">
        <!-- 起始页：标签 + TextBox + 减图标 + 加图标（§4.2 输入框高30/Padding 8,2；加减按钮=Button.Secondary+符号图标 16×16，V120） -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="起始页" Width="56" VerticalAlignment="Center" />
            <TextBox x:Name="txtStart" Width="72" Height="30" Padding="8,2" Margin="0,0,10,0"
                     TextAlignment="Center" VerticalContentAlignment="Center" />
            <Button x:Name="btnStartDown" Width="30" Height="30" Padding="0" VerticalAlignment="Center"
                    Style="{StaticResource Button.Secondary}" Click="OnStartDown">
                <Path Data="{StaticResource Icon.MinusSign}" Fill="#1F2329" Stretch="Uniform"
                      Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="btnStartUp" Width="30" Height="30" Padding="0" VerticalAlignment="Center" Margin="8,0,0,0"
                    Style="{StaticResource Button.Secondary}" Click="OnStartUp">
                <Path Data="{StaticResource Icon.PlusSign}" Fill="#1F2329" Stretch="Uniform"
                      Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </StackPanel>

        <!-- 结尾页：标签 + TextBox + 减图标 + 加图标 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="结尾页" Width="56" VerticalAlignment="Center" />
            <TextBox x:Name="txtEnd" Width="72" Height="30" Padding="8,2" Margin="0,0,10,0"
                     TextAlignment="Center" VerticalContentAlignment="Center" />
            <Button x:Name="btnEndDown" Width="30" Height="30" Padding="0" VerticalAlignment="Center"
                    Style="{StaticResource Button.Secondary}" Click="OnEndDown">
                <Path Data="{StaticResource Icon.MinusSign}" Fill="#1F2329" Stretch="Uniform"
                      Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="btnEndUp" Width="30" Height="30" Padding="0" VerticalAlignment="Center" Margin="8,0,0,0"
                    Style="{StaticResource Button.Secondary}" Click="OnEndUp">
                <Path Data="{StaticResource Icon.PlusSign}" Fill="#1F2329" Stretch="Uniform"
                      Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </StackPanel>

        <!-- 页码范围提示 -->
        <TextBlock x:Name="txtPageCount" Foreground="{StaticResource Color.TextHint}" Margin="0,0,0,0" />

        <!-- 确定/取消按钮：右下角（确定=Secondary 与取消同级普通样式，V121；用户拍板不用蓝底主操作） -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="btnOk" Content="确定" Width="72" Height="30" Margin="0,0,8,0"
                    Style="{StaticResource Button.Secondary}" Click="OnOkClick" IsDefault="True" />
            <Button x:Name="btnCancel" Content="取消" Width="72" Height="30"
                    Style="{StaticResource Button.Secondary}" Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
