  <!-- pdfium.dll 作为普通嵌入资源（不交给 Costura），程序启动时自行提取到 EXE 同目录，
       并通过 PdfiumResolver.Resolve 明确指定加载路径，避免依赖系统临时文件夹（%TEMP%），
       解决部分电脑上“PdfiumViewer.NativeMethods 类型初始值设定项引发异常”的问题。 -->
  <ItemGroup>
    <EmbeddedResource Include="$(Pkgbblanchon_PDFium_Win32)\runtimes\win-x86\native\pdfium.dll">
      <Link>assets\pdfium-x86.dll</Link>
      <LogicalName>PDFQFZ.WPF.assets.pdfium-x86.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(Pkgbblanchon_PDFium_Win32)\runtimes\win-x64\native\pdfium.dll">
      <Link>assets\pdfium-x64.dll</Link>
      <LogicalName>PDFQFZ.WPF.assets.pdfium-x64.dll</LogicalName>
    </EmbeddedResource>
    <!-- 内置调试 PDF：无文件时预览区加载它用于盖章调试（不参与输出） -->
    <EmbeddedResource Include="Assets\debug_page.pdf">
      <LogicalName>PDFQFZ.WPF.assets.debug_page.pdf</LogicalName>
    </EmbeddedResource>
